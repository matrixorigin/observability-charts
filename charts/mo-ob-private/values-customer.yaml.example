# 客户高可用容量规划示例。
#
# 本文件只保存非敏感配置。MinIO/S3 AK/SK、Grafana 登录密码和内置
# PostgreSQL 数据库密码统一填写到同目录的 customer-secrets.yaml.example 副本中：
#   install -m 0600 customer-secrets.yaml.example /root/mo-ob-customer-secrets.yaml
# 填好所有 FILL_THIS_VALUE 后执行：
#   kubectl apply -f /root/mo-ob-customer-secrets.yaml
#
# Loki 使用 S3/MinIO 保存日志；内置 PostgreSQL 使用另一个 S3/MinIO Bucket
# 保存每日备份和 WAL。Prometheus、Alertmanager 使用 PVC；Grafana 使用 PVC 和
# 下方 CloudNativePG 三副本数据库。
#
# 注释标记说明：
# - 【必须修改】安装前必须按客户现场填写或确认。
# - 【必须准备】安装前必须先创建对应的外部资源或 Kubernetes Secret。
# - 【必须确认】可以沿用示例值，但必须先检查客户现场是否冲突或满足条件。
# - 【可直接修改】不会破坏 Chart 协议，可按客户需求调整。
# - 【按容量修改】示例值可以直接修改，但必须经过容量评审。
# - 【通常保持】与 Chart/ob-ops 的兼容协议相关，不建议修改。
#
# 高可用前提：
# 1. 至少 3 个可调度节点；Loki、Prometheus、Alertmanager、Grafana 和 PostgreSQL 使用
#    hostname 级硬反亲和。这是节点级高可用，不等同于跨可用区或跨机房容灾。
# 2. 客户必须提供可动态供给 ReadWriteOnce PVC 的 StorageClass，并确认各故障域容量。
#    若使用本地 RWO 存储，原 PVC 通常不能随故障 Pod 跨节点漂移；服务可用性依赖
#    其他副本，故障盘恢复必须遵循客户存储系统流程。
# 3. Loki 使用客户独立维护的高可用 S3/MinIO 和已创建的 Bucket。
# 4. 内置 CloudNativePG 使用 3 个 PostgreSQL 实例并自动切换主库；它不是跨地域容灾。
# 5. PostgreSQL 每日备份必须使用独立 Bucket。三副本不是备份，必须做恢复演练。
# 6. Grafana NodePort 30081 必须未被占用，且节点防火墙/安全组允许客户端访问。
# 7. PDB 只保护自愿驱逐/节点维护，不能代替节点、磁盘、对象存储和数据库容灾。
#
# 下列 CPU、内存、保留时间和 PVC 大小只是可运行的评审起点，不是所有生产环境的
# 统一推荐值。请根据日志写入量、指标基数、保留周期和恢复目标修改。

# 【必须修改】完成容量评审并记录变更单、评审人和日期后，改成 YAML 布尔值 true。
# 不要写成字符串 "true"，也不要跳过 Schema 校验。
customerSizingApproved: false

# 【通常保持】国内交付默认使用已验证的国内公共镜像；如客户现场可以稳定访问
# 国外 Registry，可在 Helm 命令最后追加 values-images-upstream.yaml。
imageSource: domestic

# 内置 Grafana PostgreSQL 高可用数据库。安装本 Chart 前必须先按 README
# 独立安装并等待 CloudNativePG Operator 1.30.0 Ready。数据库 Cluster 由本
# Chart 管理，Operator 不与它放在同一 Helm release，避免首次安装 Webhook 竞态。
# CloudNativePG 管理 1 主 2 备，Service mo-ob-postgresql-rw 始终指向当前主库。
postgresql:
  enabled: true

  cluster:
    name: mo-ob-postgresql
    annotations:
      # 【通常保持】防止 helm uninstall 直接删除数据库 Cluster CR。
      helm.sh/resource-policy: keep
    # 【通常保持】3 个实例分别调度到 3 个节点。
    instances: 3
    # 【通常保持】国内镜像与国外原始镜像使用同一不可变摘要。
    imageName: >-
      ghcr.m.daocloud.io/cloudnative-pg/postgresql:17.10-202608030910-system-bookworm@sha256:8561d04754c2caf8ed203b52e96163a24ff045782ca726d01b01bbcb0649222c
    # 国外原始地址：
    # ghcr.io/cloudnative-pg/postgresql:17.10-202608030910-system-bookworm@sha256:8561d04754c2caf8ed203b52e96163a24ff045782ca726d01b01bbcb0649222c
    imagePullPolicy: IfNotPresent
    # 【可直接修改】镜像同步到客户私库时填写 Namespace 内 Secret 名称。
    imagePullSecrets: []
    # 示例：
    # imagePullSecrets:
    #   - name: harbor-image-secret
    enablePDB: true
    enableSuperuserAccess: false
    primaryUpdateMethod: switchover
    primaryUpdateStrategy: unsupervised
    affinity:
      enablePodAntiAffinity: true
      podAntiAffinityType: required
      topologyKey: kubernetes.io/hostname
    initdb:
      database: grafana
      owner: grafana
      secret:
        name: mo-ob-postgresql-app
    storage:
      # 【必须修改】没有合适的默认 StorageClass 时填写客户 RWO StorageClass。
      storageClass: ""
      # 【按容量修改】每个实例申请一个 PVC，总量为 3 × 20Gi。
      size: 20Gi
    resources:
      # 【按容量修改】数据库建议 Guaranteed QoS，因此 requests 与 limits 相同。
      requests:
        cpu: 1000m
        memory: 2Gi
      limits:
        cpu: 1000m
        memory: 2Gi
    postgresql:
      # 任一同步备库确认后提交。比异步复制更接近 RPO 0，但会增加写延迟；
      # 三节点同时只剩一个可用实例时，写入可能暂停，这是高可用取舍。
      synchronous:
        dataDurability: required
        method: any
        number: 1
      parameters:
        max_connections: "200"
  # PostgreSQL/WAL 每日备份到客户 MinIO/S3。Bucket 必须与 Loki Bucket 分开。
  # 【必须修改】安装前替换 endpointURL 和 destinationPath 中的 FILL_THIS_VALUE。
  backups:
    enabled: true
    method: barmanObjectStore
    endpointURL: FILL_THIS_VALUE
    destinationPath: s3://FILL_THIS_VALUE/mo-ob-postgresql
    # HTTPS MinIO/S3 使用私有 CA 时填写 Secret 名称和 CA 键；公共 CA 或 HTTP 留空。
    endpointCA:
      name: ""
      key: ca.crt
    secret:
      name: mo-ob-postgresql-backup-s3
    retentionPolicy: 30d
    scheduledBackups:
      - name: daily-backup
        # CloudNativePG 使用包含秒字段的 6 段 Cron：每天 02:00 执行。
        schedule: "0 0 2 * * *"
        backupOwnerReference: self
        method: barmanObjectStore
    wal:
      compression: gzip
      maxParallel: 2
    data:
      compression: gzip
      jobs: 2

mo-ob-opensource:
  loki:
    loki:
      commonConfig:
        # 【通常保持】3 个 write 副本对应 3 副本数据复制；不要低于 3。
        replication_factor: 3
      storage:
        bucketNames:
          # 【通常保持】运行时从 mo-ob-loki-s3 Secret 展开，不在 values 中写明文。
          chunks: ${LOKI_S3_BUCKET}
          ruler: ${LOKI_S3_BUCKET}
          admin: ${LOKI_S3_BUCKET}
        type: s3
        s3:
          endpoint: ${LOKI_S3_ENDPOINT}
          accessKeyId: ${LOKI_S3_ACCESS_KEY}
          secretAccessKey: ${LOKI_S3_SECRET_KEY}
          s3ForcePathStyle: ${LOKI_S3_FORCE_PATH_STYLE}
          insecure: ${LOKI_S3_INSECURE}
      limits_config:
        # 【按容量修改】日志保留时间；720h = 30 天。
        retention_period: 720h

    write:
      # 【通常保持】3 副本配合 replication_factor=3，并分散到 3 个节点。
      replicas: 3
      # 【通常保持】允许 Loki 展开上面的 ${LOKI_S3_*} 占位符。
      extraArgs:
        - -config.expand-env=true
      # 【通常保持】MinIO/S3 AK/SK 来自客户凭据文件创建的 Namespace Secret。
      extraEnvFrom:
        - secretRef:
            name: mo-ob-loki-s3
      persistence:
        # 【通常保持】Helm 升级、缩容或删除 StatefulSet 时不自动删除客户 PVC。
        enableStatefulSetAutoDeletePVC: false
        # 【必须修改】没有合适的默认 StorageClass 时，取消下一行注释并填写实际名称。
        # storageClass: customer-rwo-storage-class
        # 【按容量修改】每个 write 副本各申请一个 PVC，总量为 replicas × size。
        size: 10Gi
      resources:
        # 【按容量修改】调度依据；必须保证每个故障域都有足够资源。
        requests:
          cpu: 250m
          memory: 1Gi
        limits:
          cpu: 1000m
          memory: 1Gi

    read:
      # 【可直接修改】查询压力较大时可增加；高可用至少保持 2。
      # 当前 SimpleScalable 模式下 read 是 Deployment，不申请独立 RWO PVC。
      replicas: 2
      extraArgs:
        - -common.compactor-grpc-address=
        - -config.expand-env=true
      extraEnvFrom:
        - secretRef:
            name: mo-ob-loki-s3
      resources:
        requests:
          cpu: 250m
          memory: 3Gi
        limits:
          cpu: 1000m
          memory: 3Gi

    backend:
      # 【通常保持】3 副本承载 compactor、index-gateway 和 query-scheduler。
      replicas: 3
      extraArgs:
        - -config.expand-env=true
      extraEnvFrom:
        - secretRef:
            name: mo-ob-loki-s3
      persistence:
        enableStatefulSetAutoDeletePVC: false
        # 【必须修改】没有合适的默认 StorageClass 时取消注释并填写实际名称。
        # storageClass: customer-rwo-storage-class
        # 【按容量修改】每个 backend 副本各申请一个 PVC。
        size: 10Gi
      resources:
        requests:
          cpu: 200m
          memory: 250Mi
        limits:
          cpu: 200m
          memory: 250Mi

    gateway:
      # 【通常保持】两个网关副本避免单 Pod 故障中断 Loki 读写入口。
      replicas: 2
      resources:
        requests:
          cpu: 250m
          memory: 250Mi
        limits:
          cpu: 1000m
          memory: 1Gi

  kube-prometheus-stack:
    prometheus:
      # 两副本时保留至少一个可用副本，避免节点维护同时驱逐全部 Prometheus。
      podDisruptionBudget:
        enabled: true
        minAvailable: 1
      prometheusSpec:
        # 【通常保持】两个副本分别保存完整数据并抓取相同目标，因此抓取流量和
        # Prometheus PVC 申请量也按两个完整副本计算。
        replicas: 2
        podAntiAffinity: hard
        podAntiAffinityTopologyKey: kubernetes.io/hostname

        # 【必须修改】若安装 Namespace 不是 mo-ob，必须把 namespace 改成同一值。
        # Helm 会整体替换数组项，因此以下字段必须完整保留，不能只覆盖 namespace。
        alertingEndpoints:
          - name: mo-ob-alertmanager
            namespace: mo-ob
            port: 9093
            scheme: http
            pathPrefix: ""
            apiVersion: v2

        # 【按容量修改】指标保留时间。
        retention: 21d
        resources:
          requests:
            cpu: 1000m
            memory: 2Gi
          limits:
            cpu: 1000m
            memory: 2Gi
        storageSpec:
          volumeClaimTemplate:
            spec:
              # 【必须修改】没有合适的默认 StorageClass 时取消注释并填写实际名称。
              # storageClassName: customer-rwo-storage-class
              accessModes:
                - ReadWriteOnce
              resources:
                requests:
                  # 【按容量修改】每个 Prometheus 副本各申请一个 PVC。
                  storage: 40Gi

mo-ruler-stack:
  alertmanager:
    # 【通常保持】三个副本会自动组成 Alertmanager 集群。
    replicaCount: 3
    podAntiAffinity: hard
    podAntiAffinityTopologyKey: kubernetes.io/hostname
    podDisruptionBudget:
      minAvailable: 2
    persistence:
      enabled: true
      # 【必须修改】没有合适的默认 StorageClass 时取消注释并填写实际名称。
      # storageClass: customer-rwo-storage-class
      # 【按容量修改】每个 Alertmanager 副本各申请一个 PVC。
      size: 1Gi
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

  grafana:
    # 【通常保持】两个副本通过 NodePort Service 负载均衡，并共享内置 PostgreSQL。
    replicas: 2
    # 【通常保持】Grafana Web 用户名和密码位于 customer-secrets.yaml 中的
    # mo-ob-grafana-admin Secret，不要直接写进 values。
    admin:
      existingSecret: mo-ob-grafana-admin
      userKey: admin-user
      passwordKey: admin-password
    podDisruptionBudget:
      minAvailable: 1
    affinity:
      podAntiAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchExpressions:
                - key: app.kubernetes.io/name
                  operator: In
                  values:
                    - grafana
            topologyKey: kubernetes.io/hostname

    # 非敏感连接参数直接写入环境变量。CloudNativePG 自动为数据库 Service
    # 配置 TLS，require 会加密传输但不校验服务端 CA；如客户要求 verify-full，
    # 还需把 CloudNativePG CA 以文件形式挂载到 Grafana 并完成专项验证。
    env:
      GF_DATABASE_TYPE: postgres
      GF_DATABASE_HOST: mo-ob-postgresql-rw:5432
      GF_DATABASE_NAME: grafana
      GF_DATABASE_USER: grafana
      GF_DATABASE_SSL_MODE: require
    # Grafana 只读取应用用户密码和共享加密密钥，不会获得 PostgreSQL 超级用户权限。
    envValueFrom:
      GF_DATABASE_PASSWORD:
        secretKeyRef:
          name: mo-ob-postgresql-app
          key: password
      GF_SECURITY_SECRET_KEY:
        secretKeyRef:
          name: mo-ob-postgresql-app
          key: GF_SECURITY_SECRET_KEY

    # 每个 Grafana Pod 使用独立 RWO PVC 保存插件和本地文件；业务状态存放在内置数据库。
    persistence:
      enabled: true
      type: statefulset
      # 【必须修改】没有合适的默认 StorageClass 时取消注释并填写实际名称。
      # storageClassName: customer-rwo-storage-class
      # 【按容量修改】每个 Grafana 副本各申请一个 PVC。
      size: 5Gi

    resources:
      requests:
        cpu: 200m
        memory: 1Gi
      limits:
        cpu: 500m
        memory: 1Gi

    grafana.ini:
      unified_alerting:
        # 【通常保持】本底座使用 Prometheus + Alertmanager；这里未配置 Grafana
        # Alerting 的 HA 去重。若客户要启用，必须另行设计其 HA 和通知链路。
        enabled: false

    sidecar:
      dashboards:
        # 【通常保持】必须与 ob-ops Dashboard ConfigMap 协议一致。
        enabled: true
        label: grafana_dashboard
        labelValue: "1"
        folderAnnotation: grafana_folder
        watchMethod: SLEEP
        env:
          SLEEP_TIME: "10"
        skipReload: true
        provider:
          # 【通常保持】必须为 true，才能把 MatrixOne/MOI/K8s/Loki 文件目录
          # 映射成 Grafana Dashboard 目录。
          foldersFromFilesStructure: true
      datasources:
        # null 表示只在当前 Helm release Namespace 中搜索，避免集群级 Secret 权限。
        searchNamespace: null

    service:
      enabled: true
      # 【可直接修改】NodePort 允许通过任一可达节点 IP 直接访问 Grafana。
      type: NodePort
      port: 80
      targetPort: 3000
      # 【必须确认】范围为 30000-32767；部署前检查客户集群中没有占用。
      nodePort: 30081
      # 访问地址：http://<任一可达节点IP>:30081
      # NodePort 本身不提供 HTTPS；生产环境应在客户批准的 TLS 入口后访问。

    # 【通常保持】插件应通过相同镜像或 values 同步到两个副本，禁止只在单 Pod
    # 内手工安装，否则两个 Grafana 副本的插件会不一致。
