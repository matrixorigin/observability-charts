{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mo-ob-opensource": {
      "type": "object",
      "properties": {
        "loki": {
          "type": "object",
          "allOf": [
            {
              "if": {
                "required": [
                  "enabled",
                  "minio"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "minio": {
                    "required": [
                      "enabled"
                    ],
                    "properties": {
                      "enabled": {
                        "const": false
                      }
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "loki"
                ],
                "properties": {
                  "loki": {
                    "type": "object",
                    "required": [
                      "storage"
                    ],
                    "properties": {
                      "storage": {
                        "type": "object",
                        "required": [
                          "type",
                          "bucketNames",
                          "s3"
                        ],
                        "properties": {
                          "type": {
                            "const": "s3"
                          },
                          "bucketNames": {
                            "type": "object",
                            "required": [
                              "chunks"
                            ],
                            "properties": {
                              "chunks": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "s3": {
                            "type": "object",
                            "required": [
                              "endpoint",
                              "accessKeyId",
                              "secretAccessKey"
                            ],
                            "properties": {
                              "endpoint": {
                                "type": "string",
                                "minLength": 1
                              },
                              "accessKeyId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "secretAccessKey": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "properties": {
            "minio": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "standalone",
                    "distributed"
                  ]
                },
                "rootUser": {
                  "type": "string",
                  "minLength": 3
                },
                "rootPassword": {
                  "type": "string",
                  "minLength": 16
                },
                "persistence": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "storageClass": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
