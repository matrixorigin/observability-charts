{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mo-ob-private customer installation values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "customerSizingApproved",
    "mo-ob-opensource",
    "mo-ruler-stack"
  ],
  "definitions": {
    "dns1123Subdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "s3Bucket": {
      "const": "${LOKI_S3_BUCKET}"
    },
    "lokiCredentialConsumer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "extraArgs",
        "extraEnvFrom"
      ],
      "properties": {
        "extraArgs": {
          "type": "array",
          "contains": {
            "const": "-config.expand-env=true"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": [
              "secretRef"
            ],
            "properties": {
              "secretRef": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "allOf": [
                      {
                        "$ref": "#/definitions/dns1123Subdomain"
                      },
                      {
                        "const": "mo-ob-loki-s3"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "customerSizingApproved": {
      "const": true,
      "description": "Explicit acknowledgement that the customer resource and storage sizing has been reviewed."
    },
    "mo-ob-opensource": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "alertrules",
        "alloy",
        "promtail",
        "victoria-metrics-k8s-stack",
        "kube-prometheus-stack",
        "loki"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "alertrules": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "alloy": {
          "type": "object",
          "required": [
            "serviceMonitor"
          ],
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            }
          }
        },
        "promtail": {
          "type": "object",
          "required": [
            "serviceMonitor"
          ],
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            }
          }
        },
        "victoria-metrics-k8s-stack": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "kube-prometheus-stack": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "defaultRules",
            "grafana",
            "prometheus-node-exporter",
            "prometheusOperator",
            "prometheus",
            "kube-state-metrics"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "defaultRules": {
              "type": "object",
              "required": [
                "create"
              ],
              "properties": {
                "create": {
                  "const": false
                }
              }
            },
            "grafana": {
              "type": "object",
              "required": [
                "enabled",
                "forceDeployDashboards"
              ],
              "properties": {
                "enabled": {
                  "const": false
                },
                "forceDeployDashboards": {
                  "const": false
                }
              }
            },
            "prometheus-node-exporter": {
              "type": "object",
              "required": [
                "prometheus"
              ],
              "properties": {
                "prometheus": {
                  "type": "object",
                  "required": [
                    "monitor"
                  ],
                  "properties": {
                    "monitor": {
                      "type": "object",
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            },
            "prometheusOperator": {
              "type": "object",
              "required": [
                "serviceMonitor"
              ],
              "properties": {
                "serviceMonitor": {
                  "type": "object",
                  "required": [
                    "selfMonitor"
                  ],
                  "properties": {
                    "selfMonitor": {
                      "const": false
                    }
                  }
                }
              }
            },
            "prometheus": {
              "type": "object",
              "required": [
                "serviceMonitor",
                "prometheusSpec"
              ],
              "properties": {
                "serviceMonitor": {
                  "type": "object",
                  "required": [
                    "selfMonitor"
                  ],
                  "properties": {
                    "selfMonitor": {
                      "const": false
                    }
                  }
                },
                "prometheusSpec": {
                  "type": "object",
                  "required": [
                    "serviceMonitorSelectorNilUsesHelmValues",
                    "podMonitorSelectorNilUsesHelmValues",
                    "ruleSelectorNilUsesHelmValues",
                    "additionalScrapeConfigs",
                    "alertingEndpoints"
                  ],
                  "properties": {
                    "serviceMonitorSelectorNilUsesHelmValues": {
                      "const": false
                    },
                    "podMonitorSelectorNilUsesHelmValues": {
                      "const": false
                    },
                    "ruleSelectorNilUsesHelmValues": {
                      "const": false
                    },
                    "additionalScrapeConfigs": {
                      "type": "array",
                      "maxItems": 0
                    },
                    "alertingEndpoints": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "namespace",
                          "port"
                        ],
                        "properties": {
                          "name": {
                            "$ref": "#/definitions/dns1123Subdomain"
                          },
                          "namespace": {
                            "$ref": "#/definitions/dns1123Subdomain"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "kube-state-metrics": {
              "type": "object",
              "required": [
                "prometheus"
              ],
              "properties": {
                "prometheus": {
                  "type": "object",
                  "required": [
                    "monitor"
                  ],
                  "properties": {
                    "monitor": {
                      "type": "object",
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "loki": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "monitoring",
            "minio",
            "loki",
            "write",
            "read",
            "backend"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "minio": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false,
                  "description": "Only customer-managed external S3/MinIO is supported."
                }
              }
            },
            "monitoring": {
              "type": "object",
              "required": [
                "dashboards",
                "rules",
                "serviceMonitor"
              ],
              "properties": {
                "dashboards": {
                  "type": "object",
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                },
                "rules": {
                  "type": "object",
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                },
                "serviceMonitor": {
                  "type": "object",
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                }
              }
            },
            "loki": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "storage"
              ],
              "properties": {
                "storage": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "type",
                    "bucketNames",
                    "s3"
                  ],
                  "properties": {
                    "type": {
                      "const": "s3"
                    },
                    "bucketNames": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "chunks",
                        "ruler",
                        "admin"
                      ],
                      "properties": {
                        "chunks": {
                          "$ref": "#/definitions/s3Bucket"
                        },
                        "ruler": {
                          "$ref": "#/definitions/s3Bucket"
                        },
                        "admin": {
                          "$ref": "#/definitions/s3Bucket"
                        }
                      }
                    },
                    "s3": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "endpoint",
                        "accessKeyId",
                        "secretAccessKey",
                        "s3ForcePathStyle",
                        "insecure"
                      ],
                      "properties": {
                        "endpoint": {
                          "const": "${LOKI_S3_ENDPOINT}"
                        },
                        "accessKeyId": {
                          "const": "${LOKI_S3_ACCESS_KEY}"
                        },
                        "secretAccessKey": {
                          "const": "${LOKI_S3_SECRET_KEY}"
                        },
                        "s3ForcePathStyle": {
                          "const": "${LOKI_S3_FORCE_PATH_STYLE}"
                        },
                        "insecure": {
                          "const": "${LOKI_S3_INSECURE}"
                        }
                      }
                    }
                  }
                }
              }
            },
            "write": {
              "$ref": "#/definitions/lokiCredentialConsumer"
            },
            "read": {
              "allOf": [
                {
                  "$ref": "#/definitions/lokiCredentialConsumer"
                },
                {
                  "type": "object",
                  "properties": {
                    "extraArgs": {
                      "type": "array",
                      "contains": {
                        "const": "-common.compactor-grpc-address="
                      }
                    }
                  }
                }
              ]
            },
            "backend": {
              "$ref": "#/definitions/lokiCredentialConsumer"
            }
          }
        }
      }
    },
    "mo-ruler-stack": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "dashboards",
        "alertrules",
        "moRuler",
        "managedSecrets",
        "alertmanagerWebhookAdapter",
        "alertmanager",
        "grafana"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "dashboards": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "alertrules": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "moRuler": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "alertmanager": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "extraSecretMounts"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "extraSecretMounts": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "alertmanagerWebhookAdapter": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "managedSecrets": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "alertmanagerWebAuth",
            "alertmanagerEmail",
            "instanceServiceWebhook",
            "grafanaOAuth",
            "grafanaAdmin"
          ],
          "properties": {
            "alertmanagerWebAuth": {
              "const": false
            },
            "alertmanagerEmail": {
              "const": false
            },
            "instanceServiceWebhook": {
              "const": false
            },
            "grafanaOAuth": {
              "const": false
            },
            "grafanaAdmin": {
              "const": false
            }
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "admin",
            "serviceMonitor",
            "extraSecretMounts",
            "rbac",
            "sidecar",
            "service"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "admin": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "existingSecret",
                "userKey",
                "passwordKey"
              ],
              "properties": {
                "existingSecret": {
                  "$ref": "#/definitions/dns1123Subdomain"
                },
                "userKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              }
            },
            "serviceMonitor": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            },
            "extraSecretMounts": {
              "type": "array",
              "maxItems": 0
            },
            "rbac": {
              "type": "object",
              "required": [
                "namespaced"
              ],
              "properties": {
                "namespaced": {
                  "const": true
                }
              }
            },
            "sidecar": {
              "type": "object",
              "required": [
                "datasources"
              ],
              "properties": {
                "datasources": {
                  "type": "object",
                  "properties": {
                    "searchNamespace": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "#/definitions/dns1123Subdomain"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "service": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "nodePort": {
                  "type": "integer",
                  "minimum": 30000,
                  "maximum": 32767
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mo-ob-opensource": {
            "required": [
              "enabled",
              "loki"
            ],
            "properties": {
              "enabled": {
                "const": true
              },
              "loki": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "required": [
          "mo-ob-opensource"
        ]
      },
      "then": {
        "properties": {
          "mo-ob-opensource": {
            "required": [
              "loki"
            ],
            "properties": {
              "loki": {
                "required": [
                  "minio",
                  "loki",
                  "write",
                  "read",
                  "backend"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mo-ruler-stack": {
            "required": [
              "enabled",
              "grafana"
            ],
            "properties": {
              "enabled": {
                "const": true
              },
              "grafana": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "required": [
          "mo-ruler-stack"
        ]
      },
      "then": {
        "properties": {
          "mo-ruler-stack": {
            "required": [
              "grafana"
            ],
            "properties": {
              "grafana": {
                "required": [
                  "admin"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
