# 兼容文件：MO OB 高可用客户凭据填写模板（不是 Helm values 文件）。
# 新文档请使用 customer-secrets-ha.yaml.example；标准模式只使用
# customer-secrets-standard.yaml.example 中的两个 Secret。
#
# 使用方法：
# 1. 复制为一个不会提交到 Git 的真实文件：
#      install -m 0600 customer-secrets.yaml.example /root/mo-ob-customer-secrets.yaml
# 2. 只修改本文件中标记为【必须填写】或【必须确认】的内容。
# 3. 替换完成后检查，文件中不能再存在 FILL_THIS_VALUE：
#      grep -n 'FILL_THIS_VALUE' /root/mo-ob-customer-secrets.yaml
# 4. 一次性创建 Namespace 和四个 Secret：
#      kubectl apply -f /root/mo-ob-customer-secrets.yaml
#
# 安全要求：
# - 填写后的文件包含明文密码，权限必须保持 0600。
# - 不要把真实文件提交到 Git、打进 Chart、粘贴到工单/聊天或交付文档。
# - YAML 块字符串允许直接填写包含 :、#、单引号或双引号的密码。
# - 如果把 Namespace 从 mo-ob 改为其他名称，下面四个 Secret 的 namespace、
#   Helm --namespace，以及 values-customer.yaml 中的 Alertmanager Namespace 必须一起修改。
#
# 当前监控底座的凭据关系：
# - Loki 使用外部 S3/MinIO，需要 Endpoint、Bucket、AK 和 SK。
# - Prometheus 和 Alertmanager 使用 PVC，不需要 MinIO AK/SK。
# - Grafana 使用内置 CloudNativePG，需要 Web 管理员密码和数据库应用用户密码。
# - PostgreSQL 的每日基础备份和 WAL 使用独立 MinIO/S3 Bucket 及专用 AK/SK。
# - Alertmanager 通知渠道默认关闭，因此本模板不包含 SMTP/Webhook 密码。

apiVersion: v1
kind: Namespace
metadata:
  # 【可修改】必须与 Helm 安装时的 --namespace 一致。
  name: mo-ob

---
apiVersion: v1
kind: Secret
metadata:
  # 【通常保持】Loki write/read/backend 都引用这个 Secret 名称。
  name: mo-ob-loki-s3
  namespace: mo-ob
type: Opaque
stringData:
  # 【必须填写】集群内可以访问的 S3/MinIO 地址，必须包含 http:// 或 https://。
  # 集群内 MinIO 示例：http://minio.minio-tenant.svc.cluster.local:80
  LOKI_S3_ENDPOINT: |-
    FILL_THIS_VALUE

  # 【必须填写】提前创建的 Loki 专用 Bucket。
  # 当前 Chart 的 chunks、ruler 和 admin 数据共用这个专用 Bucket。
  LOKI_S3_BUCKET: |-
    FILL_THIS_VALUE

  # 【必须填写】建议使用只能访问上述 Loki Bucket 的专用 Access Key。
  LOKI_S3_ACCESS_KEY: |-
    FILL_THIS_VALUE

  # 【必须填写】与 Access Key 对应的 Secret Key。
  LOKI_S3_SECRET_KEY: |-
    FILL_THIS_VALUE

  # 【通常保持】MinIO 通常需要 Path Style。
  LOKI_S3_FORCE_PATH_STYLE: "true"

  # 【必须确认】Endpoint 是 http:// 时填写 true；是 https:// 时填写 false。
  LOKI_S3_INSECURE: |-
    FILL_THIS_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  # 【通常保持】Grafana Chart 已引用这个 Secret 名称和下面两个键名。
  name: mo-ob-grafana-admin
  namespace: mo-ob
type: Opaque
stringData:
  # 【可修改】Grafana Web 登录用户名。
  admin-user: |-
    admin

  # 【必须填写】Grafana Web 登录密码，建议至少 16 个字符。
  admin-password: |-
    FILL_THIS_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  # 【通常保持】CloudNativePG 初始化 grafana 用户，Grafana 只读取 password
  # 和 GF_SECURITY_SECRET_KEY；用户名必须与 values 中的 owner 一致。
  name: mo-ob-postgresql-app
  namespace: mo-ob
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
stringData:
  # 【通常保持】必须与 postgresql.cluster.initdb.owner 和 Grafana 用户一致。
  username: |-
    grafana

  # 【必须填写】Grafana 的 PostgreSQL 应用用户密码，建议至少 24 个随机字符。
  # 可生成新值：openssl rand -base64 32 | tr -d '\n'
  password: |-
    FILL_THIS_VALUE

  # 【必须填写】所有 Grafana 副本共用并长期保持不变的随机密钥，至少 32 个字符。
  # 可生成新值：openssl rand -hex 32
  # 随意更换可能导致 Grafana 已加密的数据无法解密。
  GF_SECURITY_SECRET_KEY: |-
    FILL_THIS_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  # 【通常保持】CloudNativePG 的备份与 WAL 归档引用这个 Secret。
  name: mo-ob-postgresql-backup-s3
  namespace: mo-ob
  labels:
    cnpg.io/reload: "true"
type: Opaque
stringData:
  # 【必须填写】建议使用只能访问 PostgreSQL 备份专用 Bucket 的 AK。
  ACCESS_KEY_ID: |-
    FILL_THIS_VALUE

  # 【必须填写】与上述 AK 对应的 SK。
  ACCESS_SECRET_KEY: |-
    FILL_THIS_VALUE

# 可选私有镜像仓库认证不属于本高可用底座的必填凭据，因此没有混入上面四个
# Secret。需要 Harbor/其他私库时，按照部署文档“私有镜像 Secret（可选）”章节
# 创建 Namespace 级 docker-registry Secret，并在 values 中同时配置镜像地址和引用。
