# 标准模式凭据模板。复制为本地文件后填写，严禁提交真实凭据。
#
#   install -m 0600 customer-secrets-standard.yaml.example \
#     /root/mo-ob-customer-secrets.yaml
#   grep -n FILL_THIS_VALUE /root/mo-ob-customer-secrets.yaml
#   kubectl apply -f /root/mo-ob-customer-secrets.yaml
#
# 如果修改 Namespace，必须同时修改此文件、Helm --namespace 和 values 中的
# Prometheus alertingEndpoints namespace。

apiVersion: v1
kind: Namespace
metadata:
  name: mo-ob

---
apiVersion: v1
kind: Secret
metadata:
  name: mo-ob-loki-s3
  namespace: mo-ob
type: Opaque
stringData:
  # 集群内可访问地址，例如 http://minio.minio-tenant.svc.cluster.local:80
  LOKI_S3_ENDPOINT: |-
    FILL_THIS_VALUE
  # 提前创建的 Loki 专用 Bucket。
  LOKI_S3_BUCKET: |-
    FILL_THIS_VALUE
  LOKI_S3_ACCESS_KEY: |-
    FILL_THIS_VALUE
  LOKI_S3_SECRET_KEY: |-
    FILL_THIS_VALUE
  LOKI_S3_FORCE_PATH_STYLE: "true"
  # HTTP 填 true，HTTPS 填 false。
  LOKI_S3_INSECURE: |-
    FILL_THIS_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  name: mo-ob-grafana-admin
  namespace: mo-ob
type: Opaque
stringData:
  admin-user: |-
    admin
  # 建议至少 16 个字符，不要使用 admin 或默认弱密码。
  admin-password: |-
    FILL_THIS_VALUE
